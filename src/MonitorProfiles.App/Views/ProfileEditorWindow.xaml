<Window x:Class="MonitorProfiles.App.Views.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MonitorProfiles.App.Localization"
        xmlns:coremodels="clr-namespace:MonitorProfiles.Core.Models;assembly=MonitorProfiles.Core"
        Title="{loc:Translate Editor.Title}" Width="930" Height="660" MinWidth="800" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{loc:Translate Editor.Title}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Translate Editor.Description}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,20,0,16">
            <TextBlock Text="{loc:Translate Editor.ProfileName}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
            <TextBox x:Name="NameTextBox" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="13,0,13,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Translate Editor.Screen}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                    <TextBlock Grid.Column="1" Text="{loc:Translate Editor.Width}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{loc:Translate Editor.Height}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{loc:Translate Editor.Refresh}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{loc:Translate Editor.Orientation}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="5,0" />
                    <TextBlock Grid.Column="5" Text="{loc:Translate Editor.Role}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="10,0,0,0" />
                </Grid>
                <ItemsControl x:Name="DisplayList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <CheckBox Content="{Binding Alias}" IsChecked="{Binding IsEnabled}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Descriptor.FriendlyName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="20,4,0,0" />
                                        <ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedModeOption}" DisplayMemberPath="Label" SelectionChanged="DetectedMode_SelectionChanged" ToolTip="{Binding SelectedModeOption.Label}" Margin="0,7,0,0" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Translate Editor.Width}" VerticalAlignment="Center" Margin="3" />
                                    <TextBox Grid.Column="2" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Translate Editor.Height}" VerticalAlignment="Center" Margin="3" />
                                    <TextBox Grid.Column="3" Text="{Binding RefreshRate, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Translate Editor.Refresh}" VerticalAlignment="Center" Margin="3" />
                                    <ComboBox Grid.Column="4" SelectedValue="{Binding Orientation}" SelectedValuePath="Tag" VerticalAlignment="Center" Margin="3">
                                        <ComboBoxItem Content="{loc:Translate Editor.Landscape}" Tag="{x:Static coremodels:DisplayOrientation.Landscape}" />
                                        <ComboBoxItem Content="{loc:Translate Editor.Portrait}" Tag="{x:Static coremodels:DisplayOrientation.Portrait}" />
                                        <ComboBoxItem Content="{loc:Translate Editor.LandscapeFlipped}" Tag="{x:Static coremodels:DisplayOrientation.LandscapeFlipped}" />
                                        <ComboBoxItem Content="{loc:Translate Editor.PortraitFlipped}" Tag="{x:Static coremodels:DisplayOrientation.PortraitFlipped}" />
                                    </ComboBox>
                                    <CheckBox Grid.Column="5" Content="{loc:Translate Editor.Primary}" IsChecked="{Binding IsPrimary}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Translate Editor.Cancel}" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="{loc:Translate Editor.Preview}" Click="Preview_Click" Margin="0,0,8,0" />
            <Button Content="{loc:Translate Editor.Save}" Click="Save_Click" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
