<Window x:Class="MonitorProfiles.App.Views.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:coremodels="clr-namespace:MonitorProfiles.Core.Models;assembly=MonitorProfiles.Core"
        Title="Editar perfil" Width="850" Height="640" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#0D1117" Foreground="#E8EDF4" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#151B23" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8C98A8" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F7F9FC" />
            <Setter Property="Background" Value="#252E3A" />
            <Setter Property="BorderBrush" Value="#364252" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#202833" />
            <Setter Property="Foreground" Value="#E8EDF4" />
            <Setter Property="BorderBrush" Value="#364252" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#202833" />
            <Setter Property="Foreground" Value="#E8EDF4" />
            <Setter Property="BorderBrush" Value="#364252" />
            <Setter Property="Padding" Value="7,5" />
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Configurar perfil" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Elige las pantallas activas y el modo de cada una." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,20,0,16">
            <TextBlock Text="Nombre" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6" />
            <TextBox x:Name="NameTextBox" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="13,0,13,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PANTALLA" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                    <TextBlock Grid.Column="1" Text="ANCHO" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="ALTO" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="HZ" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="ORIENTACIÓN" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="5,0" />
                    <TextBlock Grid.Column="5" Text="ROL" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="10,0,0,0" />
                </Grid>
                <ItemsControl x:Name="DisplayList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="#222B37" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <CheckBox Content="{Binding Alias}" IsChecked="{Binding IsEnabled}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Descriptor.FriendlyName}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="20,4,0,0" />
                                    <ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedModeOption}" DisplayMemberPath="Label" SelectionChanged="DetectedMode_SelectionChanged" ToolTip="Modos enumerados por Windows" Margin="0,7,0,0" />
                                </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ancho" VerticalAlignment="Center" Margin="3" />
                                    <TextBox Grid.Column="2" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" ToolTip="Alto" VerticalAlignment="Center" Margin="3" />
                                    <TextBox Grid.Column="3" Text="{Binding RefreshRate, UpdateSourceTrigger=PropertyChanged}" ToolTip="Hz" VerticalAlignment="Center" Margin="3" />
                                    <ComboBox Grid.Column="4" SelectedValue="{Binding Orientation}" SelectedValuePath="Tag" VerticalAlignment="Center" Margin="3">
                                        <ComboBoxItem Content="Horizontal" Tag="{x:Static coremodels:DisplayOrientation.Landscape}" />
                                        <ComboBoxItem Content="Vertical" Tag="{x:Static coremodels:DisplayOrientation.Portrait}" />
                                        <ComboBoxItem Content="Horizontal (volteado)" Tag="{x:Static coremodels:DisplayOrientation.LandscapeFlipped}" />
                                        <ComboBoxItem Content="Vertical (volteado)" Tag="{x:Static coremodels:DisplayOrientation.PortraitFlipped}" />
                                    </ComboBox>
                                    <CheckBox Grid.Column="5" Content="Principal" IsChecked="{Binding IsPrimary}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Probar cambios" Click="Preview_Click" Margin="0,0,8,0" />
            <Button Content="Guardar" Click="Save_Click" Background="#5478EE" BorderBrush="#5478EE" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
