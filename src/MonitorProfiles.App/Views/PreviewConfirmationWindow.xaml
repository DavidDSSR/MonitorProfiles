<Window x:Class="MonitorProfiles.App.Views.PreviewConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MonitorProfiles.App.Localization"
        Title="{loc:Translate Preview.Title}" Width="450" Height="280" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{loc:Translate Preview.Title}" FontSize="23" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="{loc:Translate Preview.Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="14" />
            <TextBlock x:Name="CountdownText" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Translate Preview.Revert}" IsCancel="True" Click="Revert_Click" Margin="0,0,8,0" />
            <Button Content="{loc:Translate Preview.Keep}" IsDefault="True" Click="Keep_Click" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
