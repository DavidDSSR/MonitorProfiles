<Window x:Class="MonitorProfiles.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitor Profiles" Height="800" Width="1120" MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#0D1117" Foreground="#E8EDF4"
        FontFamily="Segoe UI" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#151B23" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8C98A8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7C9BFF" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F7F9FC" />
            <Setter Property="Background" Value="#252E3A" />
            <Setter Property="BorderBrush" Value="#364252" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#313D4B" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#5478EE" />
            <Setter Property="BorderBrush" Value="#5478EE" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E8EDF4" />
            <Setter Property="Background" Value="#202833" />
            <Setter Property="BorderBrush" Value="#364252" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
    </Window.Resources>

    <Grid Margin="34,28" MaxWidth="1200" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="42" Height="42" Background="#202A3B" CornerRadius="12" VerticalAlignment="Center">
                <TextBlock Text="M" Foreground="#91A8FF" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Monitor Profiles" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="Controla tu espacio de trabajo" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <Border Grid.Column="2" Background="#171F2A" BorderBrush="#293442" BorderThickness="1" CornerRadius="16" Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#62D6A4" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#C5CFDC" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" x:Name="ErrorPanel" Background="#321E24" BorderBrush="#62313B" BorderThickness="1" CornerRadius="9" Padding="14,10" Margin="0,0,0,18" Visibility="Collapsed">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB5B5" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
                        <TextBlock Text="Identifica tus pantallas" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Asigna un nombre estable a cada pantalla. Después podrás usar esos nombres en tus perfiles." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,8,0,20" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Displays}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#222B37" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FriendlyName}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ModeSummary}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AliasOptions}" SelectedItem="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Content="Identificar" Tag="{Binding}" Click="IdentifyDisplay_Click" Margin="10,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Guardar y crear perfiles" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanSaveSetup}" Click="SaveSetup_Click" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="20,12" />
                    </StackPanel>

                    <StackPanel x:Name="ProfilesPanel" Visibility="Collapsed">
                        <Grid Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Tus perfiles" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Text="Un clic para cambiar todas tus pantallas" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,7,0,0" />
                            </StackPanel>
                            <Button Content="＋  Nuevo perfil" Style="{StaticResource PrimaryButton}" Click="NewProfile_Click" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#222B37" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Border Background="#202A3B" CornerRadius="9" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Kind}" FontSize="9" Foreground="#9DAFFF" FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" LineHeight="19" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Eliminar" Tag="{Binding}" Click="DeleteProfile_Click" Margin="0,0,8,0" />
                                                <Button Content="Editar" Tag="{Binding}" Click="EditProfile_Click" Margin="0,0,8,0" />
                                                <Button Content="Aplicar perfil" Tag="{Binding}" Click="ApplyProfile_Click" Style="{StaticResource PrimaryButton}" Padding="20,11" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="3" Text="Windows 11  ·  Los cambios guardados se aplican desde la ventana o la bandeja del sistema" FontSize="11" Foreground="#647181" Margin="0,18,0,0" HorizontalAlignment="Center" />
    </Grid>
</Window>
