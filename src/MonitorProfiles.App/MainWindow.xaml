<Window x:Class="MonitorProfiles.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MonitorProfiles.App.Localization"
        xmlns:storage="clr-namespace:MonitorProfiles.Storage;assembly=MonitorProfiles.Storage"
        Title="{loc:Translate App.Title}" Height="740" Width="1180" MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI Variable Text, Segoe UI"
        Closing="Window_Closing" Icon="/Resources/Brand/MonitorProfiles.ico">
    <Grid Margin="32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" VerticalAlignment="Center">
                <Image Width="29" Height="27" Source="{StaticResource MonitorProfilesLogo}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="15,0,18,0" VerticalAlignment="Center">
                <TextBlock Text="{loc:Translate App.Title}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Translate App.Tagline}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" VerticalAlignment="Center" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasErrorMessage}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <ComboBox Grid.Column="3" Width="126" ItemsSource="{Binding Languages}" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguageCode, Mode=OneWay}" SelectionChanged="LanguageSelectionChanged" ToolTip="{loc:Translate Language.Menu}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="4" Width="124" SelectedValue="{Binding SelectedTheme, Mode=OneWay}" SelectedValuePath="Tag" SelectionChanged="ThemeSelectionChanged" ToolTip="{loc:Translate Theme.Menu}" VerticalAlignment="Center">
                <ComboBoxItem Content="{loc:Translate Theme.System}" Tag="{x:Static storage:ThemePreference.System}" />
                <ComboBoxItem Content="{loc:Translate Theme.Light}" Tag="{x:Static storage:ThemePreference.Light}" />
                <ComboBoxItem Content="{loc:Translate Theme.Dark}" Tag="{x:Static storage:ThemePreference.Dark}" />
            </ComboBox>
        </Grid>

        <Border Grid.Row="1" x:Name="ErrorPanel" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" CornerRadius="10" Padding="15,11" Margin="0,0,0,18" Visibility="Collapsed">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
                        <TextBlock Text="{loc:Translate Setup.Title}" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Translate Setup.Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,7,0,22" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Displays}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FriendlyName}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ModeSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AliasOptions}" SelectedItem="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Content="{loc:Translate Common.Identify}" Tag="{Binding}" Click="IdentifyDisplay_Click" Margin="10,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{loc:Translate Setup.Save}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanSaveSetup}" Click="SaveSetup_Click" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="20,12" />
                    </StackPanel>

                    <StackPanel x:Name="ProfilesPanel" Visibility="Collapsed">
                        <Grid Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate Profiles.Title}" FontSize="28" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Translate Profiles.Subtitle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,6,0,0" />
                            </StackPanel>
                            <Button Content="{loc:Translate Profiles.New}" Click="NewProfile_Click" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="330" MinHeight="190" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="19" Margin="0,0,12,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border Background="{DynamicResource RaisedSurfaceBrush}" CornerRadius="8" Padding="8,4" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Kind}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,13,0,16" LineHeight="19" TextWrapping="Wrap" VerticalAlignment="Top" />
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="{loc:Translate Profiles.Edit}" Tag="{Binding}" Click="EditProfile_Click" Margin="0,0,7,0" />
                                                <Button Content="{loc:Translate Profiles.Delete}" Tag="{Binding}" Click="DeleteProfile_Click" Margin="0,0,7,0" />
                                                <Button Content="{loc:Translate Profiles.Apply}" Tag="{Binding}" Click="ApplyProfile_Click" Style="{StaticResource PrimaryButton}" Padding="18,9" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{loc:Translate Displays.Title}" FontSize="19" FontWeight="SemiBold" Margin="0,17,0,12" />
                        <ItemsControl ItemsSource="{Binding Displays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="250" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,10,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Border Width="38" Height="25" BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1.5" CornerRadius="4">
                                                    <Rectangle Height="1" Width="22" Fill="{DynamicResource BorderBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                </Border>
                                                <Rectangle Width="15" Height="2" Fill="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                                <Grid>
                                                    <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding State}" HorizontalAlignment="Right" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Descriptor.IsActive}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <TextBlock Text="{Binding FriendlyName}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ModeSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</Window>
